# Defaults are appropriate for a local synthetic-only demo.
PORT=3000
HOST=127.0.0.1
ENABLE_DEMO_RESET=false
# Comma-separated permitted web origins for MCP (localhost is always permitted).
# ALLOWED_ORIGIN=https://your-deployment.example

# OPTIONAL -- not validated without your AWS account.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...
# SYNCY_TABLE=syncy-care-demo    # DynamoDB table with STRING partition key patientId
# BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# BEDROCK_GUARDRAIL_ID=...
# BEDROCK_GUARDRAIL_VERSION=1
