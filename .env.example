# Defaults are appropriate for a local synthetic-only demo.
PORT=3000
HOST=127.0.0.1
ENABLE_DEMO_RESET=false
# Comma-separated permitted web origins for MCP (localhost is always permitted).
# ALLOWED_ORIGIN=https://your-deployment.example

# OPTIONAL AWS -- prefer browser login + named IAM profile (no long-lived access keys).
#   aws login --region us-east-2 --profile syncy-care-dev
#   copy this file to .env and start with: node --env-file=.env src/server.js
# Use a non-root IAM user (recommended: syncy-care-dev). Do not commit .env.
# AWS_PROFILE=syncy-care-dev
# AWS_REGION=us-east-2
# Cross-region Nova Micro inference profile (Ohio).
# BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0
# SYNCY_TABLE=syncy-care-demo    # optional DynamoDB; not required for the hackathon demo
# BEDROCK_GUARDRAIL_ID=...
# BEDROCK_GUARDRAIL_VERSION=1
# Only if you must inject temporary session credentials instead of AWS_PROFILE:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...
